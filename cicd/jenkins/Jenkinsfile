pipeline {
    agent any

    environment {
        DOCKER_REPO = 'pranav5/end-to-end-devops-project'
        CLUSTER     = 'devops-project'
        REGION      = 'us-east-1'
        BUILD_TAG    = "${BUILD_NUMBER}"
        SCANNER_HOME = tool 'sonar-scanner' 
    }

    stages {

        stage('Checkout') {
            steps {
                echo ' Cloning repository...'
                checkout scm
                // echo '📥 Pulling code from private GitHub repo...'
                // git branch: 'main', 
                //     credentialsId: 'github-token', 
                //     url: 'https://github.com/PranavBhandare007/End-to-end-Devops-Project.git'
            }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo '🔍 Running Static Code Analysis...'
                // 'sonar-server' must match the name you configured in Jenkins -> System
                withSonarQubeEnv('sonar-server') { 
                    sh '''
                        $SCANNER_HOME/bin/sonar-scanner \
                        -Dsonar.projectKey=end-to-end-devops-project \
                        -Dsonar.sources=. 
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                echo '⏳ Waiting for SonarQube Quality Gate verdict...'
                timeout(time: 10, unit: 'MINUTES') {
                    // This will abort the pipeline if SonarQube says the code quality is too low
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build Backend Image') {
            steps {
                echo ' Building backend image...'
                sh 'docker build -t $DOCKER_REPO:backend-$BUILD_TAG ./kubernetes/apps/backend'
            }
        }

        stage('Build Frontend Image') {
            steps {
                echo ' Building frontend image...'
                sh 'docker build -t $DOCKER_REPO:frontend-$BUILD_TAG ./kubernetes/apps/frontend'
            }
        }

        stage('Push to DockerHub') {
            steps {
                echo ' Pushing images to DockerHub...'
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                        echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                        docker push $DOCKER_REPO:backend-$BUILD_TAG
                        docker push $DOCKER_REPO:frontend-$BUILD_TAG
                    '''
                }
            }
        }

        stage('Deploy to EKS') {
            steps {
                echo ' Deploying to EKS...'
                sh '''
                    # 1. Authenticate with AWS EKS
                    aws eks update-kubeconfig --name $CLUSTER --region $REGION

                    # Imperative approach
                    # kubectl set image deployment/backend backend=$DOCKER_REPO:backend-$BUILD_TAG -n app
                    # kubectl set image deployment/frontend frontend=$DOCKER_REPO:frontend-$BUILD_TAG -n app

                    # 2. Declarative approach: Substitute variables and apply
                    envsubst < ./kubernetes/manifests/app/backend-deployment.yaml | kubectl apply -f - -n app
                    envsubst < ./kubernetes/manifests/app/frontend-deployment.yaml | kubectl apply -f - -n app

                    # 3. Wait for rollouts to complete
                    kubectl rollout status deployment/backend -n app --timeout=120s
                    kubectl rollout status deployment/frontend -n app --timeout=120s
                '''
            }
        }
    }

    post {
        success {
            echo ' Pipeline completed! App is live.'
        }
        failure {
            echo ' Pipeline failed. Check logs above.'
        }
        always {
            echo ' Cleaning up local Docker images...'
            sh '''
                docker rmi $DOCKER_REPO:backend-$BUILD_TAG  || true
                docker rmi $DOCKER_REPO:frontend-$BUILD_TAG || true
                docker logout || true
            '''
        }
    }
}
